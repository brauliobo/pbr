-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft_content = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let errors = result?.errors || [];
let warnings = result?.warnings || [];
let lines = split(nft_content, '\n');
let interfaces = result?.interfaces || [];
let labels = result?.interface_labels || {};
let uplink_interfaces = result?.uplink_interfaces || [];

let direct_errors = filter(errors,
	e => e.code == 'errorPolicyMwan4InterfaceTarget' && index(e.info || '', 'wan') >= 0);
let unknown_strategy_errors = filter(errors,
	e => e.code == 'errorPolicyUnknownInterface' && index(e.info || '', 'Unknown mwan4 strategy') >= 0);
let collision_warnings = filter(warnings,
	w => w.code == 'warningMwan4MarkMaskCollision');
let collision_info = collision_warnings?.[0]?.info || '';
let table_collision_warnings = filter(warnings,
	w => w.code == 'warningMwan4TableCollision');
let priority_collision_warnings = filter(warnings,
	w => w.code == 'warningMwan4PriorityCollision');
let priority_collision_info = priority_collision_warnings?.[0]?.info || '';
let direct_rules = filter(lines,
	l => index(l, 'add rule') == 0 &&
		index(l, 'mwan4_iface_in_wan') >= 0 &&
		index(l, 'Unsafe direct mwan4 interface') >= 0);
let direct_label_rules = filter(lines,
	l => index(l, 'add rule') == 0 &&
		index(l, 'mwan4_iface_in_wan') >= 0 &&
		index(l, 'Unsafe direct mwan4 label') >= 0);
let strategy_rules = filter(lines,
	l => index(l, 'add rule') == 0 &&
		index(l, 'goto mwan4_strategy_balanced_ipv4') >= 0 &&
		index(l, 'Safe mwan4 strategy') >= 0);
let unknown_strategy_rules = filter(lines,
	l => index(l, 'add rule') == 0 &&
		index(l, 'Unknown mwan4 strategy') >= 0);

let checks = [
	['result_not_null',             result != null],
	['direct_interface_rejected',   length(direct_errors) == 2],
	['unknown_strategy_rejected',   length(unknown_strategy_errors) == 1],
	['no_direct_iface_goto',        length(direct_rules) == 0],
	['no_direct_label_goto',        length(direct_label_rules) == 0],
	['no_unknown_strategy_rule',    length(unknown_strategy_rules) == 0],
	['strategy_still_accepted',     length(strategy_rules) == 1],
	['mark_collision_warned_once',  length(collision_warnings) == 1],
	['mark_collision_lists_ifaces', index(collision_info, 'wan:') >= 0 &&
		index(collision_info, 'wan6:') >= 0 &&
		index(collision_info, 'mask 0x00000f00') >= 0],
	['table_collision_warned',      length(table_collision_warnings) == 1],
	['priority_collision_warned',   length(priority_collision_warnings) == 1 &&
		index(priority_collision_info, 'vpn') >= 0],
	['direct_targets_hidden',       index(interfaces, 'wan') < 0 &&
		index(interfaces, 'wan6') < 0],
	['hidden_direct_labeled',       labels['wan'] == 'mwan4:wan'],
	['strategy_target_visible',     index(interfaces, 'mwan4_strategy_balanced') >= 0],
	['uplinks_keep_real_ifaces',    index(uplink_interfaces, 'wan') >= 0 &&
		index(uplink_interfaces, 'wan6') >= 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("policy_mwan4_direct_rejected: %d/%d passed\n", pass, pass + fail);
-- End --

