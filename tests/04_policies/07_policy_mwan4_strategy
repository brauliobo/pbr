-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft_content = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let errors = result?.errors || [];
let warnings = result?.warnings || [];

let unknown_fwmark_errors = filter(errors,
	e => e.code == 'errorPolicyProcessUnknownFwmark');
let collision_warnings = filter(warnings,
	w => w.code == 'warningMwan4MarkMaskCollision');

let lines = split(nft_content, '\n');
let strategy_rules = filter(lines,
	l => index(l, 'mwan4 strategy') >= 0 && index(l, 'add rule') == 0);

let v4_rules = filter(strategy_rules, l => index(l, 'goto mwan4_strategy_balanced_ipv4') >= 0);
let v6_rules = filter(strategy_rules, l => index(l, 'goto mwan4_strategy_balanced_ipv6') >= 0);
let alias_rules = filter(strategy_rules, l => index(l, 'Route alias via mwan4 strategy') >= 0);
let domain_rules = filter(strategy_rules,
	l => index(l, 'Route domain via mwan4 strategy') >= 0 &&
		index(l, '@pbr_mwan4_strategy_balanced_4_dst_ip_policy_strategy_domain') >= 0);
let port_rules = filter(strategy_rules,
	l => index(l, 'Route ports via mwan4 strategy') >= 0 &&
		index(l, 'sport { 443 }') >= 0 &&
		index(l, 'dport { 80, 443 }') >= 0);
let dnsmasq_content = global.mocklib.read_captured('/var/run/pbr.dnsmasq') || '';

// Snippet should also declare the strategy chain alias via `define`
let define_lines = filter(lines, l => index(l, 'define pbr_mwan4_strategy_balanced_chain') == 0);

let strategy_in_gateways = filter(result?.gateways || [],
	g => index(g.name || '', 'mwan4_strategy_') == 0);

let labels                = result?.interface_labels || {};
let interfaces            = result?.interfaces || [];
let uplink_interfaces     = result?.uplink_interfaces || [];
let wan_gw                = filter(result?.gateways || [], g => g.name == 'wan')?.[0];
let supported             = pbr.get_supported_interfaces('pbr')?.pbr || {};
let rpc_interfaces        = supported.interfaces || [];
let rpc_labels            = supported.interface_labels || {};
let rpc_uplink_interfaces = supported.uplink_interfaces || [];

let checks = [
	['result_not_null',          result != null],
	['no_unknown_fwmark',        length(unknown_fwmark_errors) == 0],
	['default_mask_disjoint',    length(collision_warnings) == 0],
	['has_strategy_rule',        length(strategy_rules) >= 2],
	['ipv4_goto_strategy',       length(v4_rules) >= 1],
	['ipv6_goto_strategy',       length(v6_rules) >= 1],
	['label_alias_accepted',     length(alias_rules) == 1],
	['domain_strategy_rule',     length(domain_rules) >= 1],
	['domain_dnsmasq_set',       index(dnsmasq_content, 'nftset=/example.com/4#inet#fw4#pbr_mwan4_strategy_balanced_4_dst_ip_policy_strategy_domain') >= 0],
	['source_port_strategy_rule', length(port_rules) >= 2],
	['nft_defines_strategy',     length(define_lines) >= 1],
	['strategy_not_in_gateways', length(strategy_in_gateways) == 0],
	// Labeling: strategy has the mwan4:strategy: prefix in the dropdown map
	['strategy_labeled',
		labels['mwan4_strategy_balanced'] == 'mwan4:strategy:balanced'],
	['strategy_labeled_failover',
		labels['mwan4_strategy_failover'] == 'mwan4:strategy:failover'],
	// 'ignore' has a self-label (no prefix)
	['ignore_self_labeled',      labels['ignore'] == 'ignore'],
	// Direct mwan4 interfaces are labeled but hidden from policy choices
	['wan_mwan4_labeled',        labels['wan'] == 'mwan4:wan'],
	// gateways[] entries carry a label field
	['wan_gateway_has_label',    wan_gw?.label == 'mwan4:wan'],
	// Round-trip API values stay canonical; labels carry the user-facing alias.
	['strategy_canonical_value', index(interfaces, 'mwan4_strategy_balanced') >= 0],
	['strategy_alias_not_value', index(interfaces, 'mwan4:strategy:balanced') < 0],
	['uplinks_are_real_ifaces',  index(uplink_interfaces, 'wan') >= 0 &&
		index(uplink_interfaces, 'wan6') >= 0 &&
		index(uplink_interfaces, 'mwan4_strategy_balanced') < 0],
	['rpc_strategy_canonical',   index(rpc_interfaces, 'mwan4_strategy_balanced') >= 0],
	['rpc_strategy_label_alias', rpc_labels['mwan4_strategy_balanced'] == 'mwan4:strategy:balanced'],
	['rpc_alias_not_value',      index(rpc_interfaces, 'mwan4:strategy:balanced') < 0],
	['rpc_uplinks_real_ifaces',  index(rpc_uplink_interfaces, 'wan') >= 0 &&
		index(rpc_uplink_interfaces, 'wan6') >= 0 &&
		index(rpc_uplink_interfaces, 'mwan4_strategy_balanced') < 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("policy_mwan4_strategy: %d/%d passed\n", pass, pass + fail);
